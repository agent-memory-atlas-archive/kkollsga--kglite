{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kglite.readthedocs.io/schemas/extensions/cypher_recipes.json",
  "title": "extensions.cypher_recipes",
  "description": "Named groups of boot-validated, parameterized, read-only Cypher queries. An empty mapping disables the recipe tools. Stored queries reject mutation clauses, EXPLAIN, PROFILE, FORMAT CSV, LOAD CSV, and a literal LIMIT equal to the server's payload cap. Row order is undefined unless a query includes deterministic ORDER BY.",
  "type": "object",
  "propertyNames": {
    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
  },
  "additionalProperties": {
    "$ref": "#/$defs/recipe"
  },
  "$defs": {
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "queries"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "queries": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/query"
          }
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "parameters",
        "cypher"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "parameters": {
          "$ref": "#/$defs/rootParameterSchema"
        },
        "cypher": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "rootParameterSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "properties",
        "required",
        "additionalProperties"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/topLevelParameterSchema"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "additionalProperties": {
          "const": false
        },
        "description": {
          "type": "string"
        }
      },
      "description": "`required` must list exactly the properties that declare no `default`; a property with a default is bound by the server when the caller omits it, and listing it as required is refused."
    },
    "parameterSchemaKeywords": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "oneOf": [
            {
              "$ref": "#/$defs/typeName"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/typeName"
              }
            }
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/parameterSchema"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "items": {
          "$ref": "#/$defs/parameterSchema"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        },
        "additionalProperties": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      },
      "description": "The closed keyword set itself. Reference parameterSchema or topLevelParameterSchema rather than this, which does not close the mapping."
    },
    "parameterSchema": {
      "description": "A nested parameter schema. No `default`: only a top-level parameter property may declare one.",
      "allOf": [
        {
          "$ref": "#/$defs/parameterSchemaKeywords"
        }
      ],
      "unevaluatedProperties": false
    },
    "topLevelParameterSchema": {
      "description": "A top-level parameter property: the same keywords plus `default`, the value the server binds when the caller omits this parameter. A default must itself satisfy this property's schema.",
      "allOf": [
        {
          "$ref": "#/$defs/parameterSchemaKeywords"
        }
      ],
      "properties": {
        "default": true
      },
      "unevaluatedProperties": false
    },
    "typeName": {
      "type": "string",
      "enum": [
        "null",
        "boolean",
        "object",
        "array",
        "number",
        "integer",
        "string"
      ]
    }
  }
}
